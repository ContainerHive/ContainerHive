{{ define "change-rules.yml.gotpl" }}
{{- if .Ctx.ChangeDetection }}
  rules:
{{- if .Image.ChangePaths }}
    - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH && $CI_COMMIT_BRANCH != $CI_DEFAULT_BRANCH
      changes:
        paths:
{{- range .Image.ChangePaths }}
          - {{ $.Ctx.RepoPath . | quote }}
{{- end }}
        compare_to: refs/heads/$CI_DEFAULT_BRANCH
    - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH && $CI_COMMIT_BRANCH != $CI_DEFAULT_BRANCH
      when: never
{{- end }}
    # Like jobs without rules, stay out of merge request pipelines, which
    # have no generate job.
    - if: $CI_PIPELINE_SOURCE != "merge_request_event"
{{- end }}
{{- end }}
