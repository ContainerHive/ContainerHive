{{ define "build-job.yml.gotpl" }}
{{- range .Image.Platforms }}
build-{{ $.Image.Name }}-{{ platform_id . }}:
  extends: .build-{{ platform_id . }}
  stage: {{ $.Image.Name }}
{{- template "change-rules.yml.gotpl" $ }}
  variables:
    IMAGE_NAME: {{ $.Image.Name }}
    PLATFORM: {{ . }}
{{- if gt $.Image.BuildShards 1 }}
  parallel: {{ $.Image.BuildShards }}
{{- end }}
  needs:
    - generate
{{- range $.Image.Dependencies }}
{{- if $.Ctx.ChangeDetection }}
    - job: manifest-{{ . }}
      optional: true
{{- else }}
    - manifest-{{ . }}
{{- end }}
{{- end }}
  artifacts:
    paths:
      - {{ $.Ctx.Dist }}/{{ $.Image.Name }}/*/*/cyclonedx.json
    reports:
      cyclonedx: {{ $.Ctx.Dist }}/{{ $.Image.Name }}/*/*/cyclonedx.json
{{ end }}
{{- end }}
