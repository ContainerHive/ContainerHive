{{ define "test-job.yml.gotpl" }}
{{- range .Image.Platforms }}
test-{{ $.Image.Name }}-{{ platform_id . }}:
  extends: .test-{{ platform_id . }}
  stage: test-{{ $.Image.Name }}
{{- template "change-rules.yml.gotpl" $ }}
  variables:
    IMAGE_NAME: {{ $.Image.Name }}
    PLATFORM: {{ . }}
{{- if gt $.Image.TestShards 1 }}
  parallel: {{ $.Image.TestShards }}
{{- end }}
  needs:
    - generate
    - build-{{ $.Image.Name }}-{{ platform_id . }}
  artifacts:
    when: always
    paths:
      - {{ $.Ctx.Dist }}/**/*-cst-report.xml
    reports:
      junit: {{ $.Ctx.Dist }}/**/*-cst-report.xml
{{- end }}
{{- end }}
