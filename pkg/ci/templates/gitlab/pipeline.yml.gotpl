# Auto-generated by ContainerHive
# Do not edit - regenerate with: {{ .Command }}
{{- if .HasTagRanges }}
# tag_ranges resolved to {{ .TagRangeUnits }} shard unit(s) - regenerate if this changes.
{{- end }}
{{- if ne (option "ci_cancel_outdated") "false" }}

workflow:
  auto_cancel:
    on_new_commit: interruptible

default:
  interruptible: true
{{- end }}

stages:
  - generate
{{- if ne (option "ci_lint") "false" }}
  - lint
{{- end }}
{{- range .Stages }}
  - {{ . }}
{{- end }}
{{- if eq (option "ci_report") "true" }}
  - report
  - pages
{{- end }}

variables:
  SNAPSHOT_ID: ${CI_MERGE_REQUEST_IID}

before_script:
  - echo "$CI_REGISTRY_PASSWORD" | {{ .ChCmd }} login -u "$CI_REGISTRY_USER" --password-stdin "$CI_REGISTRY"
{{- if .Config.Registry }}
  - echo "$CONTAINER_HIVE_REGISTRY_PASSWORD" | {{ .ChCmd }} login -u "$CONTAINER_HIVE_REGISTRY_USERNAME" --password-stdin "{{ .Config.RegistryHost }}"
{{- end }}

# === BASE TEMPLATES ===

.build:
  image:
    name: {{ .ImageName }}:{{ .Version }}
    entrypoint: [""]
  services:
    - name: {{ option "ci_buildkit_image" }}:{{ option "ci_buildkit_version" }}
      alias: buildkitd
      command: ["--addr", "tcp://0.0.0.0:8372"]
{{- if and .HasTagRanges (ne (option "ci_version_cache") "false") }}
  cache:
    key: ch-versions
    paths:
      - {{ .VersionCacheDir }}/
    policy: pull
{{- end }}
  variables:
    BUILDKIT_HOST: tcp://buildkitd:8372
{{- if and .HasTagRanges (ne (option "ci_version_cache") "false") }}
    CONTAINER_HIVE_CACHE_DIR: {{ .VersionCacheDir }}
{{- end }}
  script:
    - {{ .ChCmd }} wait --buildkitd
    - {{ .ChCmd }} build ${IMAGE_NAME} --platform ${PLATFORM} --build-id "$SNAPSHOT_ID"
    - {{ .ChCmd }} sbom ${IMAGE_NAME} --platform ${PLATFORM} --build-id "$SNAPSHOT_ID"{{ if eq (option "ci_sbom_generate_cpes") "false" }} --no-cpe{{ end }}
{{ range .Platforms }}
.build-{{ platform_id . }}:
  extends: .build
{{ end }}
.manifest:
  image:
    name: {{ .ImageName }}:{{ .Version }}
    entrypoint: [""]
{{- if and .HasTagRanges (ne (option "ci_version_cache") "false") }}
  cache:
    key: ch-versions
    paths:
      - {{ .VersionCacheDir }}/
    policy: pull
  variables:
    CONTAINER_HIVE_CACHE_DIR: {{ .VersionCacheDir }}
{{- end }}
  script:
    - {{ .ChCmd }} finalize ${IMAGE_NAME} --build-id "$SNAPSHOT_ID"

.test:
  image:
    name: {{ .ImageName }}:{{ .Version }}
    entrypoint: [""]
  services:
    - name: {{ option "ci_dind_image" }}
      alias: dind
      command: ["dockerd", "--host=tcp://0.0.0.0:2375"]
{{- if and .HasTagRanges (ne (option "ci_version_cache") "false") }}
  cache:
    key: ch-versions
    paths:
      - {{ .VersionCacheDir }}/
    policy: pull
{{- end }}
  variables:
    DOCKER_HOST: tcp://dind:2375
    DOCKER_TLS_CERTDIR: ""
{{- if and .HasTagRanges (ne (option "ci_version_cache") "false") }}
    CONTAINER_HIVE_CACHE_DIR: {{ .VersionCacheDir }}
{{- end }}
  script:
    - {{ .ChCmd }} wait --docker-socket
    - {{ .ChCmd }} test ${IMAGE_NAME} --platform ${PLATFORM} --build-id "$SNAPSHOT_ID"
{{ range .Platforms }}
.test-{{ platform_id . }}:
  extends: .test
{{ end }}

# === GENERATE ===
generate:
  image:
    name: {{ .ImageName }}:{{ .Version }}
    entrypoint: [""]
  stage: generate
{{- template "always-rules.yml.gotpl" . }}
{{- if and .HasTagRanges (ne (option "ci_version_cache") "false") }}
  cache:
    key: ch-versions
    paths:
      - {{ .VersionCacheDir }}/
    policy: pull-push
{{- end }}
{{- if or .ChangeDetection (and .HasTagRanges (ne (option "ci_version_cache") "false")) }}
  variables:
{{- if and .HasTagRanges (ne (option "ci_version_cache") "false") }}
    CONTAINER_HIVE_CACHE_DIR: {{ .VersionCacheDir }}
{{- end }}
{{- if .ChangeDetection }}
    # Change detection diffs against the merge base with the target or
    # default branch, which needs the full history and the default branch.
    GIT_DEPTH: "0"
    GIT_FETCH_EXTRA_FLAGS: --prune --quiet +refs/heads/$CI_DEFAULT_BRANCH:refs/remotes/origin/$CI_DEFAULT_BRANCH
{{- end }}
{{- end }}
  script:
    - {{ .ChCmd }} generate --build-id "$SNAPSHOT_ID"
{{- if .ChangeDetection }}
    - |
      if [ "$CI_PIPELINE_SOURCE" = "merge_request_event" ]; then
        {{ .ChCmd }} changes --base "$CI_MERGE_REQUEST_DIFF_BASE_SHA" --unmatched ignore --strict --write
      elif [ "$CI_PIPELINE_SOURCE" = "push" ] && [ -n "$CI_COMMIT_BRANCH" ] && [ "$CI_COMMIT_BRANCH" != "$CI_DEFAULT_BRANCH" ]; then
        {{ .ChCmd }} changes --base "refs/remotes/origin/$CI_DEFAULT_BRANCH" --unmatched ignore --strict --write
      fi
{{- end }}
  artifacts:
    paths:
      - {{ .Dist }}/
    expire_in: 1 week
{{- if ne (option "ci_lint") "false" }}
{{ template "lint-job.yml.gotpl" . }}
{{- end }}
{{ range .Images }}
# === {{ .Name | upper }} ===
{{ template "build-job.yml.gotpl" (dict "Image" . "Ctx" $) }}
{{ template "manifest-job.yml.gotpl" (dict "Image" . "Ctx" $) }}
{{ template "test-job.yml.gotpl" (dict "Image" . "Ctx" $) }}
{{- end }}
{{- if eq (option "ci_report") "true" }}

report:
  image:
    name: {{ .ImageName }}:{{ .Version }}
    entrypoint: [""]
  stage: report
{{- template "always-rules.yml.gotpl" . }}
{{- if and .HasTagRanges (ne (option "ci_version_cache") "false") }}
  cache:
    key: ch-versions
    paths:
      - {{ .VersionCacheDir }}/
    policy: pull
  variables:
    CONTAINER_HIVE_CACHE_DIR: {{ .VersionCacheDir }}
{{- end }}
  needs:
    - generate
  {{- range $img := .Images }}
  {{- range $p := $img.Platforms }}
  {{- if $.ChangeDetection }}
    - job: build-{{ $img.Name }}-{{ platform_id $p }}
      optional: true
  {{- else }}
    - build-{{ $img.Name }}-{{ platform_id $p }}
  {{- end }}
  {{- end }}
  {{- end }}
  script:
    - {{ .ChCmd }} report
    - {{ .ChCmd }} report --json
    - mkdir -p public
    - mv {{ .Dist }}/report.html public/index.html
    - mv {{ .Dist }}/report.json public/report.json
  artifacts:
    paths:
      - public/
    expose_as: "CH Report"
    expire_in: 1 week

pages:
  needs:
    - report
  script:
    - echo "Deploy happens via convention on job name"
  stage: pages
  before_script: []
  rules:
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
{{- end }}
