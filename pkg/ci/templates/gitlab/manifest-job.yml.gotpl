{{ define "manifest-job.yml.gotpl" }}
manifest-{{ .Image.Name }}:
  extends: .manifest
  stage: manifest-{{ .Image.Name }}
{{- template "change-rules.yml.gotpl" . }}
  variables:
    IMAGE_NAME: {{ .Image.Name }}
  needs:
    - generate
{{- range .Image.Platforms }}
    - test-{{ $.Image.Name }}-{{ platform_id . }}
    - build-{{ $.Image.Name }}-{{ platform_id . }}
{{- end }}
{{- end }}
