{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>timo-reymann/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Pinned via a go.mod replace: docker/docker@v28.x references deprecated type aliases (archive.Compression) that go-archive removed in v0.2.0. Bumping this pin breaks the build.",
      "matchManagers": ["gomod"],
      "matchDepNames": ["github.com/moby/go-archive"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend non-major updates"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": "frontend major updates"
    },
    {
      "description": "Group nix and chisel backend toolchain updates into one feat PR every two weeks",
      "matchFileNames": [
        "internal/buildkit/build_context/nix.go",
        "internal/buildkit/build_context/chisel.go"
      ],
      "groupName": "nix and chisel backend toolchain",
      "semanticCommits": "enabled",
      "semanticCommitType": "feat",
      "semanticCommitScope": "deps",
      "schedule": ["* 4 1,15 * *"]
    }
  ],
  "regexManagers": [
    {
      "description": "Update GitHub Actions versions in internal/actions/versions.go via renovate comments",
      "fileMatch": ["internal/actions/versions\\.go$"],
      "matchStrings": [
        "=\\s*\"(?<currentValue>[^\"]+)\"\\s+//\\s+renovate:\\s+datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)"
      ]
    },
    {
      "description": "Nix builder image used by the nix build backend",
      "fileMatch": ["internal/buildkit/build_context/nix\\.go$"],
      "matchStrings": [
        "DefaultNixBuilderImage\\s*=\\s*\"(?<depName>[^:\"]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Builder image used by the chisel build backend",
      "fileMatch": ["internal/buildkit/build_context/chisel\\.go$"],
      "matchStrings": [
        "DefaultChiselBuilderImage\\s*=\\s*\"(?<depName>[^:\"]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Chisel tool release used by the chisel build backend",
      "fileMatch": ["internal/buildkit/build_context/chisel\\.go$"],
      "matchStrings": [
        "DefaultChiselVersion\\s*=\\s*\"(?<currentValue>v[0-9][^\"]*)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "canonical/chisel",
      "versioningTemplate": "semver"
    }
  ]
}